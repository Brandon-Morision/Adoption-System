# =====================================================================
# COUNTY ADOPTION RECORDS SYSTEM (AODS)
# Production Environment Configuration
# =====================================================================

NODE_ENV=production
HOST=0.0.0.0
SERVER_PORT=3001

# HTTPS / TLS Configuration
HTTPS_ENABLED=true
HTTPS_PORT=3443
TLS_CERT_PATH=server/certs/server.crt
TLS_KEY_PATH=server/certs/server.key
TLS_CA_PATH=server/certs/aods-ca.crt

# Security & CORS (Permits local and LAN browser clients)
ALLOWED_ORIGINS=https://localhost:3443,https://127.0.0.1:3443,https://192.168.1.108:3443,https://Brandon-sE-book:3443,http://localhost:3001,http://127.0.0.1:3001,http://192.168.1.108:3001,http://localhost:8443,http://127.0.0.1:8443
SESSION_TTL_HOURS=8
MAX_FAILED_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Database Configuration (SQLite Primary)
DB_TYPE=sqlite
DB_PATH=server/data/adoption_records.db

# Logging & Retention
LOG_LEVEL=info
LOG_DIR=server/data/logs
MAX_LOG_SIZE_MB=10
MAX_LOG_FILES=3
